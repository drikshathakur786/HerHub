                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="110" id="mission-height"/>
                                                        </constraints>
                                                        <string key="text">Our mission is to help you understand your body without the fear, shame, or confusion. We believe tracking your cycle should feel natural and empowering—not clinical or cold. HerHub is here to help you embrace your rhythm and feel confident in your own skin, every single day.</string>
                                                        <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
